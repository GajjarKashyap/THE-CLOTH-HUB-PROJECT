    }
    products {
        int id PK
        varchar name 
        varchar category 
        varchar brand 
        text description 
        decimal price 
        varchar image_url 
        timestamp created_at 
    }
    order_items {
        int id PK
        int order_id FK
        int product_id FK
        int quantity 
        decimal price 
        varchar size 
    }
